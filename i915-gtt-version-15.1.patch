From 1d054ae55685c45c23aa86541427dfc72afa9ca1 Mon Sep 17 00:00:00 2001
From: Emmanuel Vadot <manu@FreeBSD.org>
Date: Wed, 7 Oct 2026 08:21:07 +0200
Subject: [PATCH] i915: FreeBSD: Fix vulkan on FreeBSD 15.1

FreeBSD 15.1 doesn't support version 4 and 5 of gtt interface, keep
using version 3 as otherwise it breaks vulkan.

Sponsored by:	Beckhoff Automation GmbH & Co. KG
---
 drivers/gpu/drm/i915/gem/i915_gem_mman.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/i915/gem/i915_gem_mman.c b/drivers/gpu/drm/i915/gem/i915_gem_mman.c
index 2d94542f4d..dc54c4bc50 100644
--- a/drivers/gpu/drm/i915/gem/i915_gem_mman.c
+++ b/drivers/gpu/drm/i915/gem/i915_gem_mman.c
@@ -266,7 +266,7 @@ static unsigned int tile_row_pages(const struct drm_i915_gem_object *obj)
  */
 int i915_gem_mmap_gtt_version(void)
 {
-#if __FreeBSD_version < 1500508 || (__FreeBSD_version >= 1600000 && __FreeBSD_version < 1600015)
+#if __FreeBSD_version < 1500508 || (__FreeBSD_version >= 1501000 && __FreeBSD_version < 1600015)
 	return 3;
 #else
 	return 5;
-- 
2.53.0

